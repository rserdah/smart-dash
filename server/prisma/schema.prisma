generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "sqlite"
    url      = "file:./dev.db"
}

model Widget {
    id                              Int                             @id @default(autoincrement())
    type                            String
    title                           String
    col                             Int
    row                             Int
    colSpan                         Int
    rowSpan                         Int
    deviceId                        Int?
    device                          Device?                         @relation(fields: [deviceId], references: [id])
}

enum DeviceProvider {
    LOCAL
    HOME_ASSISTANT
    SMARTTHINGS
    CUSTOM_RPI
}

model Device {
    id                              Int                             @id @default(autoincrement())
    name                            String
    type                            String
    provider                        DeviceProvider                  @default(LOCAL)
    capabilities                    Json                            @default("[]")
    state                           String
    createdAt                       DateTime                        @default(now())

    widgets                         Widget[]
}
